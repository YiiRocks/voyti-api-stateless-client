{
    "name": "yiirocks/voyti-api-stateless-client",
    "description": "SPA-friendly JSON API for the Voyti ecosystem: credential login, account, RBAC admin, audit log, with dynamic 2FA/social-auth/GDPR bridges",
    "type": "library",
    "keywords": [
        "yii",
        "yii3",
        "user",
        "auth",
        "spa",
        "api",
        "rest",
        "openapi",
        "rbac",
        "2fa",
        "gdpr",
        "oauth2",
        "social",
        "audit-log",
        "extension"
    ],
    "homepage": "https://www.yii.rocks/voyti/api-spa/",
    "license": "BSD-3-Clause",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Mr.42",
            "homepage": "https://mr42.me/",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/YiiRocks/voyti-api-stateless-client/issues",
        "source": "https://github.com/YiiRocks/voyti-api-stateless-client/tree/main"
    },
    "provide": {
        "yiirocks/voyti-views": "^1.0"
    },
    "require": {
        "php": ">=8.3",
        "psr/clock": "^1.0",
        "psr/event-dispatcher": "^1.0",
        "psr/http-message": "^1.0 || ^2.0",
        "yiirocks/voyti": "^1.0",
        "yiirocks/voyti-api": "^1.0",
        "yiisoft/data-db": "^1.0",
        "yiisoft/data-response": "^2.2",
        "yiisoft/http": "^1.2",
        "yiisoft/input-http": "^1.0",
        "yiisoft/router": "^4.0"
    },
    "require-dev": {
        "ext-pdo_sqlite": "*",
        "friendsofphp/php-cs-fixer": "@stable",
        "infection/infection": "^0.35.0",
        "nyholm/psr7": "^1.8",
        "phpunit/phpunit": "@stable",
        "rector/rector": "^2.1.1",
        "vimeo/psalm": "^6.0",
        "yiirocks/voyti-2fa": "^1.0",
        "yiirocks/voyti-2fa-email": "^1.0",
        "yiirocks/voyti-2fa-totp": "^1.0",
        "yiirocks/voyti-2fa-webauthn": "^1.0",
        "yiirocks/voyti-gdpr": "^1.0",
        "yiirocks/voyti-social-auth": "^1.0",
        "yiirocks/voyti-views-bootstrap5": "^1.0",
        "yiisoft/code-style": "^1.1",
        "yiisoft/db-sqlite": "^2.0",
        "yiisoft/dummy-provider": "^1.1",
        "yiisoft/mailer": "^6.1",
        "yiisoft/translator-message-php": "^1.0",
        "yiisoft/view": "^12.0"
    },
    "suggest": {
        "yiirocks/voyti-2fa": "Enables /v1/2fa/* endpoints and 2FA login-challenge support",
        "yiirocks/voyti-2fa-email": "Enables /v1/2fa/email/send-code",
        "yiirocks/voyti-2fa-totp": "Enables /v1/2fa/totp/* setup endpoints",
        "yiirocks/voyti-2fa-webauthn": "Enables /v1/2fa/webauthn/* passkey registration endpoints",
        "yiirocks/voyti-gdpr": "Enables /v1/gdpr/* consent/export/delete endpoints",
        "yiirocks/voyti-social-auth": "Enables /v1/auth/social/* OAuth2 login endpoints"
    },
    "autoload": {
        "psr-4": {
            "YiiRocks\\Voyti\\Api\\StatelessClient\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "YiiRocks\\Voyti\\Api\\StatelessClient\\tests\\": "tests"
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "scripts": {
        "php-cs-fixer": "@php vendor/bin/php-cs-fixer fix",
        "phpunit": "@php vendor/bin/phpunit",
        "psalm": "@php vendor/bin/psalm",
        "infection": "@php vendor/bin/infection",
        "rector": "@php vendor/bin/rector process"
    },
    "scripts-descriptions": {
        "php-cs-fixer": "Cleans to code with PHP Coding Standards Fixer.",
        "phpunit": "PHPUnit - programmer-oriented testing framework.",
        "psalm": "Psalm - static analysis tool for finding errors in PHP applications.",
        "infection": "Infection - PHP Mutation Testing Framework.",
        "rector": "Rector - automated tool for refactoring and upgrading PHP code."
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "config-plugin-options": {
            "source-directory": "config"
        },
        "config-plugin": {
            "params": "params.php",
            "di": "di.php"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/YiiRocks"
        }
    ]
}
